<!--
  views/about.ejs - Public "About" page
  Describes what AI JobCoach does, the team mission, and lists
  the four team members. Accessible without authentication.
-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI JobCoach</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <%- include('partials/header') %>
    <main class="jobcoach-page">
        
        <section>
            <br>
            <h2 class="panel-title">🚀 What is AI JobCoach?</h2>
            <p>
                AI JobCoach is an interactive platform designed to help students succeed in their job search. 
                Upload your resume, cover letter, and job description to receive real-time, AI-powered feedback 🤖.
            </p>
            <p>
                Powered by advanced AI technology, our tool provides:
            </p>
            <ul>
                <li>✅ Clear strengths and improvement suggestions</li>
                <li>📊 An overall compatibility score</li>
                <li>🎯 Personalized insights tailored to your target role</li>
            </ul>
            <p>
                Our goal is simple: help you align your documents with your dream job and put your best foot forward — every time.
            </p>
        </section>

        <section>
            <h2 class="panel-title">🌟 Our Mission</h2>
            <p>
                As students ourselves, we understand how challenging it can be to break into the workforce. 
                Our mission is to empower fellow students with practical tools, smart feedback, and the confidence 
                they need to turn their ambitions into real careers 💼✨.
            </p>
        </section>

        <section>
            <h2 class="panel-title">👥 Meet the Team</h2>
            <p>
                
                Victor Santana 🇩🇴<br>
                Xander Humphreys 🇺🇸<br>
                Ethan Buhman 🇺🇸 <br>
                Daniel Acosta 🇲🇽
            </p>
        </section>

    </main>
    <%- include('partials/footer') %>
</body>
</html>