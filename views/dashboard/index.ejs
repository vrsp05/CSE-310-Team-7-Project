<!--
  views/dashboard/index.ejs - Main dashboard (requires auth)
  Users paste a job description on the left and upload a Resume or
  Cover Letter (PDF/DOCX) on the right using the tabbed panel.
  On upload, the file is saved to Supabase Storage automatically.
  Clicking ANALYZE sends the file to POST /generate-file, which
  calls Gemini and stores the result in session, then redirects
  to /dashboard/analysis.
  Previously saved files are loaded into the picker dropdowns
  via GET /api/storage/list so users can re-analyze old files.
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI JobCoach</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <meta name="jc-user" content="<%= user ? user.username : 'guest' %>" />
</head>
<body>
  <%- include('../partials/header') %>


  <main class="jobcoach-page">

    <!-- Page Title -->
    <header class="jobcoach-hero">
      <br>
      <h1 class="jobcoach-title">AI JobCoach</h1>
      <p class="jobcoach-subtitle">Submit your Resume or Cover Letter Here...</p>
    </header>

    <!-- Main framed container -->
    <section class="jobcoach-frame">

      <div class="jobcoach-grid">

        <!-- LEFT: Job Description -->
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">JOB DESCRIPTION</h2>
          </div>

          <div class="panel-body">
            <textarea
              class="job-textarea"
              name="jobDescription"
              id="jobDescription"
              placeholder="Paste job description here..."
            ></textarea>
          </div>
        </div>

        <!-- RIGHT: Resume/Cover Letter -->
        <div class="panel">
          <!-- Tabs -->
          <div class="tabs">
            <button class="tab tab-active" type="button" data-tab="resume">RESUME</button>
            <button class="tab" type="button" data-tab="cover">COVER LETTER</button>
          </div>

          <!-- Resume Tab Content -->
          <div class="tab-content tab-content-active" id="tab-resume">
            <div class="upload-box" id="resumeUploadBox">
              <div class="upload-icon" aria-hidden="true">📄</div>

              <!-- Saved PDFs picker (shown if any exist) -->
              <div id="resumePickerArea" style="display:none; width:100%; margin-bottom:12px;">
                <div class="picker-label">Select a saved resume:</div>
                <select class="picker-select" id="resumePicker">
                  <option value="">— Upload a new file —</option>
                </select>
                <div class="picker-or">or upload a new file below</div>
              </div>

              <div class="upload-title" id="resumeUploadTitle">Drag &amp; Drop Resume</div>
              <div class="upload-subtitle">Supports PDF, DOCX</div>

              <!-- Hidden file input + styled button -->
              <input class="file-input" type="file" id="resumeFile" accept=".pdf,.doc,.docx" />
              <button class="btn btn-primary" type="button" id="btnChooseResume">CHOOSE FILE</button>

              <p class="upload-filename" id="resumeFilename">No file selected</p>
            </div>
          </div>

          <!-- Cover Letter Tab Content -->
          <div class="tab-content" id="tab-cover">
            <div class="upload-box" id="coverUploadBox">
              <div class="upload-icon" aria-hidden="true">📝</div>

              <!-- Saved PDFs picker (shown if any exist) -->
              <div id="coverPickerArea" style="display:none; width:100%; margin-bottom:12px;">
                <div class="picker-label">Select a saved cover letter:</div>
                <select class="picker-select" id="coverPicker">
                  <option value="">— Upload a new file —</option>
                </select>
                <div class="picker-or">or upload a new file below</div>
              </div>

              <div class="upload-title">Drag &amp; Drop Cover Letter</div>
              <div class="upload-subtitle">Supports PDF, DOCX</div>

              <input class="file-input" type="file" id="coverFile" accept=".pdf,.doc,.docx" />
              <button class="btn btn-primary" type="button" id="btnChooseCover">CHOOSE FILE</button>

              <p class="upload-filename" id="coverFilename">No file selected</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ANALYZE button (uploads resume + job description and sends to AI) -->
      <div class="jobcoach-actions">
        <button class="btn btn-analyze" type="button" id="btnAnalyze">ANALYZE</button>
      </div>

      <!-- Result preview area -->
      <section class="jobcoach-frame" style="margin-top:18px;">
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">AI Preview</h2>
          </div>
          <div class="panel-body">
            <div id="geminiOutput" style="margin-top:12px; white-space:pre-wrap; background:#f7f8fa; padding:12px; border-radius:6px; min-height:80px;">No response yet.</div>
          </div>
        </div>
      </section>

    </section>
  </main>

  <%- include('../partials/footer') %>

 <script>
  (() => {
    // ─── 1. DOM refs ───────────────────────────────────────────────────
    const resumeFileInput = document.getElementById('resumeFile');
    const coverFileInput  = document.getElementById('coverFile');
    const tabButtons      = document.querySelectorAll('.tab');
    const resumeContent   = document.getElementById('tab-resume');
    const coverContent    = document.getElementById('tab-cover');

    // ─── 2. Choose File buttons ────────────────────────────────────────
    document.getElementById('btnChooseResume').addEventListener('click', () => resumeFileInput.click());
    document.getElementById('btnChooseCover').addEventListener('click',  () => coverFileInput.click());

    // ─── 3. Tabs ───────────────────────────────────────────────────────
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tabButtons.forEach(b => b.classList.remove('tab-active'));
        btn.classList.add('tab-active');
        const t = btn.dataset.tab;
        resumeContent.classList.toggle('tab-content-active', t === 'resume');
        coverContent.classList.toggle('tab-content-active',  t === 'cover');
      });
    });

    // ─── 4. Upload to Supabase on file change ─────────────────────────
    async function uploadToSupabase(fileInput, bucket, filenameId) {
      const file    = fileInput.files[0];
      const display = document.getElementById(filenameId);
      if (!file) { display.textContent = 'No file selected'; return; }

      display.textContent = `Uploading ${file.name}... ⏳`;

      const fd = new FormData();
      fd.append('file', file);
      fd.append('bucket', bucket);

      try {
        const res  = await fetch('/api/storage/upload', { method: 'POST', credentials: 'same-origin', body: fd });
        const data = await res.json();
        if (res.ok) {
          display.textContent = `✅ ${file.name} (Saved!)`;
        } else {
          display.textContent = `❌ Upload failed: ${data.error}`;
          fileInput.value = '';
        }
      } catch(e) {
        display.textContent = '❌ Server connection error';
      }
    }

    resumeFileInput.addEventListener('change', () => {
      document.getElementById('resumePicker').value = '';
      uploadToSupabase(resumeFileInput, 'resumes', 'resumeFilename');
    });
    coverFileInput.addEventListener('change', () => {
      document.getElementById('coverPicker').value = '';
      uploadToSupabase(coverFileInput, 'cover-letters', 'coverFilename');
    });

    // ─── 5. Load saved files from Supabase into pickers ───────────────
    async function loadPicker(bucket, pickerId, pickerAreaId) {
      try {
        const res  = await fetch(`/api/storage/list?bucket=${bucket}`, { credentials: 'same-origin' });
        const data = await res.json();
        if (!res.ok || !data.files?.length) return;

        const area   = document.getElementById(pickerAreaId);
        const picker = document.getElementById(pickerId);
        // reset options to default
        picker.innerHTML = '<option value="">— Upload a new file —</option>';
        area.style.display = '';

        // Deduplicate by base filename (keep newest) to avoid showing many copies
        // dedup by path
        const byPath = new Map();
        data.files.forEach(f => {
          const created = f.created_at ? new Date(f.created_at).toISOString() : new Date().toISOString();
          const existing = byPath.get(f.name);
          if (!existing || created > existing.created_at) {
            byPath.set(f.name, { ...f, created_at: created });
          }
        });

        Array.from(byPath.values())
          .sort((a,b) => (b.created_at||'').localeCompare(a.created_at||''))
          .forEach(f => {
            const base = f.name.replace(/^[^\/]+\//, '').replace(/^\d+_/, '');
            const opt        = document.createElement('option');
            opt.value        = f.url;
            opt.dataset.name = f.name;
            opt.textContent  = base || f.name.replace(/^[^\/]+\//, '');
            picker.appendChild(opt);
          });
      } catch(e) { console.warn('Picker load failed:', e); }
    }

    loadPicker('resumes',       'resumePicker', 'resumePickerArea');
    loadPicker('cover-letters', 'coverPicker',  'coverPickerArea');

    // ─── 6. Fetch signed URL → File object ────────────────────────────
    async function fetchFileFromUrl(signedUrl, filename) {
      const res  = await fetch(signedUrl);
      const blob = await res.blob();
      return new File([blob], filename, { type: blob.type });
    }

    // ─── 7. Analyze button ─────────────────────────────────────────────
    document.getElementById('btnAnalyze').addEventListener('click', async () => {
      const activeTab    = document.querySelector('.tab.tab-active')?.dataset?.tab;
      const isCover      = activeTab === 'cover';
      const geminiOutput = document.getElementById('geminiOutput');
      const fieldName    = isCover ? 'coverFile'   : 'resumeFile';
      const picker       = document.getElementById(isCover ? 'coverPicker'  : 'resumePicker');
      const fileInput    = isCover ? coverFileInput : resumeFileInput;
      const jd           = document.getElementById('jobDescription').value || '';

      geminiOutput.textContent = 'Preparing file...';
      document.getElementById('btnAnalyze').disabled = true;

      let fileToSend = null;
      try {
        if (picker.value) {
          const rawName  = picker.selectedOptions[0]?.dataset?.name || 'file.pdf';
          const filename = rawName.replace(/^[^/]+\/\d+_/, '');
          geminiOutput.textContent = 'Fetching saved file...';
          fileToSend = await fetchFileFromUrl(picker.value, filename);
        } else {
          fileToSend = fileInput.files[0] || null;
        }

        if (!fileToSend) {
          geminiOutput.textContent = isCover
            ? 'Please choose a cover letter (PDF or DOCX) or select a saved one.'
            : 'Please choose a resume (PDF or DOCX) or select a saved one.';
          document.getElementById('btnAnalyze').disabled = false;
          return;
        }

        geminiOutput.textContent = 'Sending to AI...';
        const fd = new FormData();
        fd.append(fieldName, fileToSend);
        fd.append('jobDescription', jd);

        const resp = await fetch('/generate-file', { method: 'POST', credentials: 'same-origin', body: fd });
        const data = await resp.json();

        if (!resp.ok) {
          geminiOutput.textContent = 'AI error: ' + (data?.error || JSON.stringify(data));
          document.getElementById('btnAnalyze').disabled = false;
          return;
        }

        geminiOutput.textContent = 'AI analysis complete — redirecting...';
        setTimeout(() => { window.location.href = '/dashboard/analysis'; }, 600);

      } catch(err) {
        console.error(err);
        geminiOutput.textContent = 'Network or server error. Check console.';
        document.getElementById('btnAnalyze').disabled = false;
      }
    });

  })();
  </script>
</body>
</html>
