<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI JobCoach</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <meta name="jc-user" content="<%= user ? user.username : 'guest' %>" />
</head>
<body>
  <%- include('../partials/header') %>


  <main class="jobcoach-page">

    <!-- Page Title -->
    <header class="jobcoach-hero">
      <h1 class="jobcoach-title">AI JobCoach</h1>
      <p class="jobcoach-subtitle">AI-powered career coaching for your next opportunity</p>
    </header>

    <!-- Main framed container -->
    <section class="jobcoach-frame">

      <div class="jobcoach-grid">

        <!-- LEFT: Job Description -->
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">JOB DESCRIPTION</h2>

            <!-- URL button (you can wire this to backend later) -->
            <button class="btn btn-outline" type="button" id="btnJobUrl">
              <span class="icon-link" aria-hidden="true">🔗</span>
              <span>URL</span>
            </button>
          </div>

          <div class="panel-body">
            <textarea
              class="job-textarea"
              name="jobDescription"
              id="jobDescription"
              placeholder="Paste job description here..."
            ></textarea>
          </div>
        </div>

        <!-- RIGHT: Resume/Cover Letter -->
        <div class="panel">
          <!-- Tabs -->
          <div class="tabs">
            <button class="tab tab-active" type="button" data-tab="resume">RESUME</button>
            <button class="tab" type="button" data-tab="cover">COVER LETTER</button>
          </div>

          <!-- Resume Tab Content -->
          <div class="tab-content tab-content-active" id="tab-resume">
            <div class="upload-box" id="resumeUploadBox">
              <div class="upload-icon" aria-hidden="true">📄</div>

              <!-- Saved PDFs picker (shown if any exist) -->
              <div id="resumePickerArea" style="display:none; width:100%; margin-bottom:12px;">
                <div class="picker-label">Select a saved resume:</div>
                <select class="picker-select" id="resumePicker">
                  <option value="">— Upload a new file —</option>
                </select>
                <div class="picker-or">or upload a new file below</div>
              </div>

              <div class="upload-title" id="resumeUploadTitle">Drag &amp; Drop Resume</div>
              <div class="upload-subtitle">Supports PDF, DOCX</div>

              <!-- Hidden file input + styled button -->
              <input class="file-input" type="file" id="resumeFile" accept=".pdf,.doc,.docx" />
              <button class="btn btn-primary" type="button" id="btnChooseResume">CHOOSE FILE</button>

              <p class="upload-filename" id="resumeFilename">No file selected</p>
            </div>
          </div>

          <!-- Cover Letter Tab Content -->
          <div class="tab-content" id="tab-cover">
            <div class="upload-box" id="coverUploadBox">
              <div class="upload-icon" aria-hidden="true">📝</div>

              <!-- Saved PDFs picker (shown if any exist) -->
              <div id="coverPickerArea" style="display:none; width:100%; margin-bottom:12px;">
                <div class="picker-label">Select a saved cover letter:</div>
                <select class="picker-select" id="coverPicker">
                  <option value="">— Upload a new file —</option>
                </select>
                <div class="picker-or">or upload a new file below</div>
              </div>

              <div class="upload-title">Drag &amp; Drop Cover Letter</div>
              <div class="upload-subtitle">Supports PDF, DOCX</div>

              <input class="file-input" type="file" id="coverFile" accept=".pdf,.doc,.docx" />
              <button class="btn btn-primary" type="button" id="btnChooseCover">CHOOSE FILE</button>

              <p class="upload-filename" id="coverFilename">No file selected</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ANALYZE button (uploads resume + job description and sends to AI) -->
      <div class="jobcoach-actions">
        <button class="btn btn-analyze" type="button" id="btnAnalyze">ANALYZE</button>
      </div>

      <!-- Result preview area -->
      <section class="jobcoach-frame" style="margin-top:18px;">
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">AI Preview</h2>
          </div>
          <div class="panel-body">
            <div id="geminiOutput" style="margin-top:12px; white-space:pre-wrap; background:#f7f8fa; padding:12px; border-radius:6px; min-height:80px;">No response yet.</div>
          </div>
        </div>
      </section>

    </section>
  </main>

  <%- include('../partials/footer') %>

  <script>
    // ─── Namespace from server ─────────────────────────────────────────
    const username = document.querySelector('meta[name="jc-user"]')?.getAttribute('content') || 'guest';
    const RESUME_KEY = `jc_resumes_${username}`;
    const COVER_KEY  = `jc_covers_${username}`;

    // ─── Load saved PDFs into pickers ─────────────────────────────────
    function loadPicker(storageKey, pickerId, pickerAreaId) {
      let items = [];
      try { items = JSON.parse(localStorage.getItem(storageKey) || '[]'); } catch(e) {}
      // Only show items that have a stored PDF
      const pdfs = items.filter(i => i.dataUrl);
      const pickerArea = document.getElementById(pickerAreaId);
      const picker = document.getElementById(pickerId);
      if (pdfs.length === 0) { pickerArea.style.display = 'none'; return; }
      pickerArea.style.display = '';
      // Clear & rebuild options
      picker.innerHTML = '<option value="">— Upload a new file —</option>';
      pdfs.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.id;
        opt.textContent = item.title || 'Untitled';
        picker.appendChild(opt);
      });
    }

    loadPicker(RESUME_KEY, 'resumePicker', 'resumePickerArea');
    loadPicker(COVER_KEY,  'coverPicker',  'coverPickerArea');

    // ─── Auto-select from profile "Analyze" button ─────────────────────
    const analyzeId   = sessionStorage.getItem('jc_analyze_id');
    const analyzeType = sessionStorage.getItem('jc_analyze_type');
    if (analyzeId) {
      sessionStorage.removeItem('jc_analyze_id');
      sessionStorage.removeItem('jc_analyze_type');
      const pickerId = analyzeType === 'resume' ? 'resumePicker' : 'coverPicker';
      const picker = document.getElementById(pickerId);
      if (picker) {
        picker.value = analyzeId;
        picker.dispatchEvent(new Event('change'));
        // Switch to the right tab
        const tabTarget = analyzeType === 'resume' ? 'resume' : 'cover';
        document.querySelectorAll('.tab').forEach(b => {
          b.classList.toggle('tab-active', b.dataset.tab === tabTarget);
        });
        document.getElementById('tab-resume').classList.toggle('tab-content-active', tabTarget === 'resume');
        document.getElementById('tab-cover').classList.toggle('tab-content-active',  tabTarget === 'cover');
      }
    }

    // When a saved PDF is selected, hide the file input area; when "upload new" selected, show it
    document.getElementById('resumePicker').addEventListener('change', function() {
      const showUpload = !this.value;
      document.getElementById('resumeUploadTitle').style.display = showUpload ? '' : 'none';
      document.getElementById('btnChooseResume').style.display   = showUpload ? '' : 'none';
      document.getElementById('resumeFilename').style.display    = showUpload ? '' : 'none';
      document.getElementById('resumeFile').value = '';
      if (!showUpload) document.getElementById('resumeFilename').textContent = 'No file selected';
    });
    document.getElementById('coverPicker').addEventListener('change', function() {
      const showUpload = !this.value;
      document.getElementById('coverUploadBox').querySelector('.upload-title').style.display = showUpload ? '' : 'none';
      document.getElementById('btnChooseCover').style.display  = showUpload ? '' : 'none';
      document.getElementById('coverFilename').style.display   = showUpload ? '' : 'none';
      document.getElementById('coverFile').value = '';
      if (!showUpload) document.getElementById('coverFilename').textContent = 'No file selected';
    });

    // ─── Helper: base64 dataUrl → File object ──────────────────────────
    function dataUrlToFile(dataUrl, filename) {
      const [header, b64] = dataUrl.split(',');
      const mime = header.match(/:(.*?);/)[1];
      const binary = atob(b64);
      const arr = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) arr[i] = binary.charCodeAt(i);
      return new File([arr], filename, { type: mime });
    }

    // ─── Get the active resume File (from picker or file input) ────────
    function getResumeFile() {
      const pickerId = document.getElementById('resumePicker').value;
      if (pickerId) {
        let items = [];
        try { items = JSON.parse(localStorage.getItem(RESUME_KEY) || '[]'); } catch(e) {}
        const saved = items.find(i => i.id === pickerId);
        if (saved?.dataUrl) return dataUrlToFile(saved.dataUrl, (saved.title || 'resume').replace(/[^a-z0-9]/gi,'_') + '.pdf');
      }
      return document.getElementById('resumeFile')?.files?.[0] || null;
    }

    // ─── Tabs logic ────────────────────────────────────────────────────
    const tabButtons = document.querySelectorAll(".tab");
    const resumeContent = document.getElementById("tab-resume");
    const coverContent = document.getElementById("tab-cover");

    tabButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        tabButtons.forEach(b => b.classList.remove("tab-active"));
        btn.classList.add("tab-active");
        const target = btn.dataset.tab;
        resumeContent.classList.toggle("tab-content-active", target === "resume");
        coverContent.classList.toggle("tab-content-active", target === "cover");
      });
    });

    // ─── "Choose File" buttons ─────────────────────────────────────────
    const resumeFile = document.getElementById("resumeFile");
    const coverFile  = document.getElementById("coverFile");

    document.getElementById("btnChooseResume").addEventListener("click", () => resumeFile.click());
    document.getElementById("btnChooseCover").addEventListener("click",  () => coverFile.click());

    resumeFile.addEventListener("change", () => {
      document.getElementById("resumeFilename").textContent = resumeFile.files?.[0]?.name || "No file selected";
      // Clear picker selection when a new file is chosen
      document.getElementById('resumePicker').value = '';
    });
    coverFile.addEventListener("change", () => {
      document.getElementById("coverFilename").textContent = coverFile.files?.[0]?.name || "No file selected";
      document.getElementById('coverPicker').value = '';
    });

    // ─── URL button ────────────────────────────────────────────────────
    document.getElementById("btnJobUrl").addEventListener("click", () => {
      const url = prompt("Paste the job posting URL:");
      if (!url) return;
      const textarea = document.getElementById("jobDescription");
      textarea.value = `URL: ${url}\n\n` + textarea.value;
    });

    // ─── Analyze button ────────────────────────────────────────────────
    document.getElementById("btnAnalyze").addEventListener("click", async () => {
      const resume = getResumeFile();
      const jd = document.getElementById('jobDescription')?.value || '';
      const geminiOutput = document.getElementById('geminiOutput');

      if (!resume) {
        geminiOutput.textContent = 'Please choose a resume file to upload (PDF or DOCX), or select one from your saved resumes.';
        return;
      }

      geminiOutput.textContent = 'Uploading and sending to AI...';
      document.getElementById('btnAnalyze').disabled = true;

      try {
        const fd = new FormData();
        fd.append('resumeFile', resume);
        fd.append('jobDescription', jd);

        const resp = await fetch('/generate-file', { method: 'POST', credentials: 'same-origin', body: fd });
        const data = await resp.json();
        if (!resp.ok) {
          geminiOutput.textContent = 'AI error: ' + (data?.error || JSON.stringify(data));
          document.getElementById('btnAnalyze').disabled = false;
          return;
        }

        geminiOutput.textContent = 'AI analysis complete — redirecting to Analysis page...';
        setTimeout(() => { window.location.href = '/dashboard/analysis'; }, 600);
      } catch (err) {
        console.error('Network or server error', err);
        geminiOutput.textContent = 'Network or server error. Check console.';
        document.getElementById('btnAnalyze').disabled = false;
      }
    });

  </script>
</body>
</html>
