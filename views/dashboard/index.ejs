<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI JobCoach</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <meta name="jc-user" content="<%= user ? user.username : 'guest' %>" />
</head>
<body>
  <%- include('../partials/header') %>


  <main class="jobcoach-page">

    <!-- Page Title -->
    <header class="jobcoach-hero">
      <br>
      <h1 class="jobcoach-title">AI JobCoach</h1>
      <p class="jobcoach-subtitle">AI-powered career coaching for your next opportunity</p>
    </header>

    <!-- Main framed container -->
    <section class="jobcoach-frame">

      <div class="jobcoach-grid">

        <!-- LEFT: Job Description -->
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">JOB DESCRIPTION</h2>

            <!-- URL button (you can wire this to backend later) -->
            <button class="btn btn-outline" type="button" id="btnJobUrl">
              <span class="icon-link" aria-hidden="true">🔗</span>
              <span>URL</span>
            </button>
          </div>

          <div class="panel-body">
            <textarea
              class="job-textarea"
              name="jobDescription"
              id="jobDescription"
              placeholder="Paste job description here..."
            ></textarea>
          </div>
        </div>

        <!-- RIGHT: Resume/Cover Letter -->
        <div class="panel">
          <!-- Tabs -->
          <div class="tabs">
            <button class="tab tab-active" type="button" data-tab="resume">RESUME</button>
            <button class="tab" type="button" data-tab="cover">COVER LETTER</button>
          </div>

          <!-- Resume Tab Content -->
          <div class="tab-content tab-content-active" id="tab-resume">
            <div class="upload-box" id="resumeUploadBox">
              <div class="upload-icon" aria-hidden="true">📄</div>

              <!-- Saved PDFs picker (shown if any exist) -->
              <div id="resumePickerArea" style="display:none; width:100%; margin-bottom:12px;">
                <div class="picker-label">Select a saved resume:</div>
                <select class="picker-select" id="resumePicker">
                  <option value="">— Upload a new file —</option>
                </select>
                <div class="picker-or">or upload a new file below</div>
              </div>

              <div class="upload-title" id="resumeUploadTitle">Drag &amp; Drop Resume</div>
              <div class="upload-subtitle">Supports PDF, DOCX</div>

              <!-- Hidden file input + styled button -->
              <input class="file-input" type="file" id="resumeFile" accept=".pdf,.doc,.docx" />
              <button class="btn btn-primary" type="button" id="btnChooseResume">CHOOSE FILE</button>

              <p class="upload-filename" id="resumeFilename">No file selected</p>
            </div>
          </div>

          <!-- Cover Letter Tab Content -->
          <div class="tab-content" id="tab-cover">
            <div class="upload-box" id="coverUploadBox">
              <div class="upload-icon" aria-hidden="true">📝</div>

              <!-- Saved PDFs picker (shown if any exist) -->
              <div id="coverPickerArea" style="display:none; width:100%; margin-bottom:12px;">
                <div class="picker-label">Select a saved cover letter:</div>
                <select class="picker-select" id="coverPicker">
                  <option value="">— Upload a new file —</option>
                </select>
                <div class="picker-or">or upload a new file below</div>
              </div>

              <div class="upload-title">Drag &amp; Drop Cover Letter</div>
              <div class="upload-subtitle">Supports PDF, DOCX</div>

              <input class="file-input" type="file" id="coverFile" accept=".pdf,.doc,.docx" />
              <button class="btn btn-primary" type="button" id="btnChooseCover">CHOOSE FILE</button>

              <p class="upload-filename" id="coverFilename">No file selected</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ANALYZE button (uploads resume + job description and sends to AI) -->
      <div class="jobcoach-actions">
        <button class="btn btn-analyze" type="button" id="btnAnalyze">ANALYZE</button>
      </div>

      <!-- Result preview area -->
      <section class="jobcoach-frame" style="margin-top:18px;">
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">AI Preview</h2>
          </div>
          <div class="panel-body">
            <div id="geminiOutput" style="margin-top:12px; white-space:pre-wrap; background:#f7f8fa; padding:12px; border-radius:6px; min-height:80px;">No response yet.</div>
          </div>
        </div>
      </section>

    </section>
  </main>

  <%- include('../partials/footer') %>

 <script>
    // ─── 1. DOM Elements ───────────────────────────────────────────────
    const resumeFile = document.getElementById("resumeFile");
    const coverFile  = document.getElementById("coverFile");
    const tabButtons = document.querySelectorAll(".tab");
    const resumeContent = document.getElementById("tab-resume");
    const coverContent = document.getElementById("tab-cover");

    // ─── 2. "Choose File" Button Links ─────────────────────────────────
    document.getElementById("btnChooseResume").addEventListener("click", () => resumeFile.click());
    document.getElementById("btnChooseCover").addEventListener("click",  () => coverFile.click());

    // ─── 3. NEW SUPABASE UPLOAD LOGIC ──────────────────────────────────
    async function uploadToSupabase(fileInput, bucketName, filenameElementId) {
        const file = fileInput.files[0];
        const filenameDisplay = document.getElementById(filenameElementId);
        
        if (!file) {
            filenameDisplay.textContent = "No file selected";
            return;
        }

        filenameDisplay.textContent = `Uploading ${file.name}... ⏳`;

        const formData = new FormData();
        formData.append('file', file);
        formData.append('bucket', bucketName); 

        try {
            const response = await fetch('/api/storage/upload', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (response.ok) {
                filenameDisplay.textContent = `✅ ${file.name} (Saved securely!)`;
            } else {
                filenameDisplay.textContent = `❌ Upload failed: ${data.error}`;
                fileInput.value = ''; 
            }
        } catch (error) {
            console.error("Upload Error:", error);
            filenameDisplay.textContent = "❌ Server connection error";
        }
    }

    // Connect Resume Input to Supabase
    resumeFile.addEventListener("change", () => {
        document.getElementById('resumePicker').value = '';
        uploadToSupabase(resumeFile, 'resumes', 'resumeFilename');
    });

    // Connect Cover Letter Input to Supabase
    coverFile.addEventListener("change", () => {
        document.getElementById('coverPicker').value = '';
        uploadToSupabase(coverFile, 'cover-letters', 'coverFilename');
    });

    // ─── 4. Tabs logic ─────────────────────────────────────────────────
    tabButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        tabButtons.forEach(b => b.classList.remove("tab-active"));
        btn.classList.add("tab-active");
        const target = btn.dataset.tab;
        resumeContent.classList.toggle("tab-content-active", target === "resume");
        coverContent.classList.toggle("tab-content-active", target === "cover");
      });
    });

    // ─── 5. URL button ─────────────────────────────────────────────────
    document.getElementById("btnJobUrl").addEventListener("click", () => {
      const url = prompt("Paste the job posting URL:");
      if (!url) return;
      const textarea = document.getElementById("jobDescription");
      textarea.value = `URL: ${url}\n\n` + textarea.value;
    });

    // ─── 6. Analyze button (Temporary Placeholder) ─────────────────────
    document.getElementById("btnAnalyze").addEventListener("click", async () => {
      alert("AI Analysis connection is next! For now, your files are safely in Supabase.");
    });

  </script>
</body>
</html>
