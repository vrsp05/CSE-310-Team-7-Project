<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Profile — AI JobCoach</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/profile.css" />
  <meta name="jc-user" content="<%= user ? user.username : 'guest' %>" />
</head>
<body>
  <%- include('../partials/header') %>

  <main class="jobcoach-page">
    <header class="jobcoach-hero jobcoach-hero-compact">
      <h1 class="jobcoach-title">My Profile</h1>
      <p class="jobcoach-subtitle">Your saved resumes &amp; cover letters</p>
    </header>

    <!-- ─── TAB BAR ─────────────────────────────────────────────────── -->
    <div class="profile-tabs">
      <button class="profile-tab profile-tab-active" data-tab="resumes">
        📄 Resumes
        <span class="profile-tab-count" id="resumeCount">0</span>
      </button>
      <button class="profile-tab" data-tab="covers">
        📝 Cover Letters
        <span class="profile-tab-count" id="coverCount">0</span>
      </button>
    </div>

    <!-- ─── RESUMES SECTION ──────────────────────────────────────────── -->
    <section class="profile-section" id="section-resumes">
      <div class="profile-section-header">
        <h2 class="profile-section-title">Saved Resumes</h2>
        <button class="btn btn-primary" type="button" id="btnAddResume">+ Upload Resume PDF</button>
      </div>

      <!-- Upload form -->
      <div class="profile-add-form" id="resumeForm" style="display:none;">
        <div class="profile-form-inner">
          <h3 class="profile-form-title">Upload Resume</h3>
          <label class="profile-label">Title / Company <span style="color:#dc2626">*</span>
            <input type="text" id="resumeTitle" class="profile-input" placeholder='e.g. "Google — Software Engineer"' />
          </label>
          <label class="profile-label">Notes (optional)
            <textarea id="resumeNotes" class="profile-textarea" rows="2" placeholder="Job it was tailored for, date applied, etc."></textarea>
          </label>
          <label class="profile-label">Resume PDF <span style="color:#dc2626">*</span>
            <div class="profile-file-drop" id="resumeDropZone">
              <span class="profile-file-drop-icon">📄</span>
              <span id="resumeDropLabel">Drag &amp; drop a PDF here, or click to browse</span>
              <input type="file" id="resumeFilePdf" accept=".pdf,.doc,.docx" class="profile-file-input-hidden" />
            </div>
          </label>
          <div class="profile-form-actions">
            <button class="btn btn-primary" type="button" id="btnSaveResume">Save Resume</button>
            <button class="btn btn-outline" type="button" id="btnCancelResume">Cancel</button>
          </div>
        </div>
      </div>

      <div class="profile-list" id="resumeList"></div>
    </section>

    <!-- ─── COVER LETTERS SECTION ────────────────────────────────────── -->
    <section class="profile-section" id="section-covers" style="display:none;">
      <div class="profile-section-header">
        <h2 class="profile-section-title">Saved Cover Letters</h2>
        <button class="btn btn-primary" type="button" id="btnAddCover">+ Upload Cover Letter PDF</button>
      </div>

      <!-- Upload form -->
      <div class="profile-add-form" id="coverForm" style="display:none;">
        <div class="profile-form-inner">
          <h3 class="profile-form-title">Upload Cover Letter</h3>
          <label class="profile-label">Title / Company <span style="color:#dc2626">*</span>
            <input type="text" id="coverTitle" class="profile-input" placeholder='e.g. "Amazon — Cover Letter"' />
          </label>
          <label class="profile-label">Notes (optional)
            <textarea id="coverNotes" class="profile-textarea" rows="2" placeholder="Notes about this cover letter..."></textarea>
          </label>
          <label class="profile-label">Cover Letter PDF <span style="color:#dc2626">*</span>
            <div class="profile-file-drop" id="coverDropZone">
              <span class="profile-file-drop-icon">📝</span>
              <span id="coverDropLabel">Drag &amp; drop a PDF here, or click to browse</span>
              <input type="file" id="coverFilePdf" accept=".pdf,.doc,.docx" class="profile-file-input-hidden" />
            </div>
          </label>
          <div class="profile-form-actions">
            <button class="btn btn-primary" type="button" id="btnSaveCover">Save Cover Letter</button>
            <button class="btn btn-outline" type="button" id="btnCancelCover">Cancel</button>
          </div>
        </div>
      </div>

      <div class="profile-list" id="coverList"></div>
    </section>

  </main>

  <%- include('../partials/footer') %>

  <script>
  (() => {
    // Prevent any implicit form submissions from reloading the page
    document.addEventListener('submit', e => e.preventDefault());

    const username   = document.querySelector('meta[name="jc-user"]')?.getAttribute('content') || 'guest';
    const RESUME_KEY = `jc_resumes_${username}`;
    const COVER_KEY  = `jc_covers_${username}`;

    // Dedup helper (by path or id)
    function dedupByPath(items) {
      const map = new Map();
      items.forEach(it => {
        const key = it.path || it.id;
        if (!key) return;
        if (!map.has(key)) map.set(key, it);
      });
      return Array.from(map.values());
    }

    // ─── Helpers ───────────────────────────────────────────────────────
    function loadItems(key) {
      try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch(e) { return []; }
    }
    function saveItems(key, items) { localStorage.setItem(key, JSON.stringify(items)); }
    function newId() { return Date.now().toString(36) + Math.random().toString(36).slice(2,6); }
    function formatDate(iso) {
      return new Date(iso).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
    }
    function escHtml(str) {
      return String(str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function scoreColor(s) {
      const n = parseInt(s,10);
      return n >= 80 ? '#16a34a' : n >= 60 ? '#d97706' : '#dc2626';
    }
    async function uploadToSupabase(file, bucket) {
      const fd = new FormData();
      fd.append('file', file);
      fd.append('bucket', bucket);
      const resp = await fetch('/api/storage/upload', { method: 'POST', body: fd, credentials: 'same-origin' });
      const data = await resp.json();
      if (!resp.ok) throw new Error(data?.error || 'Upload failed');
      return { path: data.path, signedUrl: data.signedUrl || null };
    }

    async function syncFromSupabase(bucket, key) {
      try {
        const resp = await fetch(`/api/storage/list?bucket=${bucket}`, { credentials: 'same-origin' });
        const data = await resp.json();
        if (!resp.ok || !data.files) return;

        // Dedup by base filename (keep newest)
        const byName = new Map();
        data.files.forEach(f => {
          const nameOnly = f.name.replace(/^[^\/]+\//, '').replace(/^\d+_/, '');
          const created = f.created_at ? new Date(f.created_at).toISOString() : new Date().toISOString();
          const existing = byName.get(nameOnly);
          if (!existing || created > existing.createdAt) {
            byName.set(nameOnly, {
              id: f.name,
              title: nameOnly || 'Untitled',
              notes: '',
              dataUrl: f.url,
              path: f.name,
              createdAt: created,
              score: null
            });
          }
        });
        const items = Array.from(byName.values()).sort((a,b) => (b.createdAt||'').localeCompare(a.createdAt||''));
        saveItems(key, items);
      } catch(e) { console.warn('syncFromSupabase failed', e); }
    }

    // ─── Toast ─────────────────────────────────────────────────────────
    function showToast(msg) {
      const t = document.createElement('div');
      t.className = 'profile-toast';
      t.textContent = msg;
      document.body.appendChild(t);
      requestAnimationFrame(() => t.classList.add('profile-toast-show'));
      setTimeout(() => { t.classList.remove('profile-toast-show'); setTimeout(() => t.remove(), 350); }, 2500);
    }

    // ─── Tab switching ─────────────────────────────────────────────────
    document.querySelectorAll('.profile-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.profile-tab').forEach(b => b.classList.remove('profile-tab-active'));
        btn.classList.add('profile-tab-active');
        const t = btn.dataset.tab;
        document.getElementById('section-resumes').style.display = t === 'resumes' ? '' : 'none';
        document.getElementById('section-covers').style.display  = t === 'covers'  ? '' : 'none';
      });
    });

    // ─── Drag & Drop file zone setup ───────────────────────────────────
    function setupDropZone(zoneId, inputId, labelId) {
      const zone  = document.getElementById(zoneId);
      const input = document.getElementById(inputId);
      const label = document.getElementById(labelId);
      if (!zone) return;
      zone.addEventListener('click', (e) => {
        // Avoid double file dialogs when clicking directly on the input
        if (e.target === input) return;
        input.click();
      });
      zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('profile-file-drop-hover'); });
      zone.addEventListener('dragleave', () => zone.classList.remove('profile-file-drop-hover'));
      zone.addEventListener('drop', e => {
        e.preventDefault();
        zone.classList.remove('profile-file-drop-hover');
        const file = e.dataTransfer?.files?.[0];
        if (file) setFakeFile(input, file, label);
      });
      input.addEventListener('change', () => {
        const file = input.files?.[0];
        if (file) label.textContent = '✅ ' + file.name;
      });
    }
    function setFakeFile(input, file, label) {
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        input.files = dt.files;
        label.textContent = '✅ ' + file.name;
      } catch(e) { label.textContent = '✅ ' + file.name; }
    }

    setupDropZone('resumeDropZone', 'resumeFilePdf', 'resumeDropLabel');
    setupDropZone('coverDropZone',  'coverFilePdf',  'coverDropLabel');

    // ─── Render Resumes ────────────────────────────────────────────────
    function renderResumes() {
      const items = dedupByPath(loadItems(RESUME_KEY));
      saveItems(RESUME_KEY, items);
      document.getElementById('resumeCount').textContent = items.length;
      const list = document.getElementById('resumeList');
      if (items.length === 0) {
        list.innerHTML = `
          <div class="profile-empty">
            <div class="profile-empty-icon">📄</div>
            <p>No resumes saved yet. Click <strong>+ Upload Resume PDF</strong> to get started.</p>
          </div>`;
        return;
      }
      list.innerHTML = items.map(item => `
        <div class="profile-card" data-id="${item.id}">
          <div class="profile-card-header">
            <div>
              <span class="profile-card-icon">📄</span>
              <span class="profile-card-title">${escHtml(item.title || 'Untitled Resume')}</span>
              <span class="profile-card-meta">
                ${formatDate(item.createdAt)}
                <span class="profile-has-pdf">☁️ Saved in Supabase</span>
              </span>
            </div>
            <div class="profile-card-actions">
              <button class="btn btn-outline btn-sm" data-action="preview" data-id="${item.id}" data-type="resume">👁 View</button>
              <button class="btn btn-outline btn-sm" data-action="analyze" data-id="${item.id}" data-type="resume">🔬 Analyze</button>
              <button class="btn btn-outline btn-sm btn-danger" data-action="delete" data-id="${item.id}" data-type="resume">Delete</button>
            </div>
          </div>
        </div>`).join('');
    }

    // ─── Render Cover Letters ──────────────────────────────────────────
    function renderCovers() {
      const items = dedupByPath(loadItems(COVER_KEY));
      saveItems(COVER_KEY, items);
      document.getElementById('coverCount').textContent = items.length;
      const list = document.getElementById('coverList');
      if (items.length === 0) {
        list.innerHTML = `
          <div class="profile-empty">
            <div class="profile-empty-icon">📝</div>
            <p>No cover letters saved yet. Click <strong>+ Upload Cover Letter PDF</strong> to get started.</p>
          </div>`;
        return;
      }
      list.innerHTML = items.map(item => `
        <div class="profile-card" data-id="${item.id}">
          <div class="profile-card-header">
            <div>
              <span class="profile-card-icon">📝</span>
              <span class="profile-card-title">${escHtml(item.title || 'Untitled Cover Letter')}</span>
              <span class="profile-card-meta">
                ${formatDate(item.createdAt)}
                <span class="profile-has-pdf">☁️ Saved in Supabase</span>
              </span>
            </div>
            <div class="profile-card-actions">
              <button class="btn btn-outline btn-sm" data-action="preview" data-id="${item.id}" data-type="cover">👁 View</button>
              <button class="btn btn-outline btn-sm btn-danger" data-action="delete" data-id="${item.id}" data-type="cover">Delete</button>
            </div>
          </div>
        </div>`).join('');
    }

    // ─── NEW: Fetch from Supabase on Page Load ─────────────────────────
    async function loadCloudData() {
        try {
            const resp = await fetch('/api/storage/files');
            const data = await resp.json();

            if (!data.files) return;

            const resumes = [];
            const covers = [];

            // Sort the JSON data into the right tabs and clean up the filenames
            data.files.forEach(row => {
                if (row.resume_text) {
                    resumes.push({
                        id: row.id,
                        // This math removes your UUID and the timestamp to show the original clean filename!
                        title: row.resume_text.split('/').pop().split('_').slice(1).join('_'),
                        createdAt: row.created_at
                    });
                }
                if (row.cover_letter_text) {
                    covers.push({
                        id: row.id,
                        title: row.cover_letter_text.split('/').pop().split('_').slice(1).join('_'),
                        createdAt: row.created_at
                    });
                }
            });

            // Send the cleaned data to our render functions
            renderResumes(resumes);
            renderCovers(covers);

        } catch (e) {
            console.error("Failed to fetch cloud files:", e);
            showToast("Failed to sync files with the cloud.");
        }
    }

    // Kick off the fetch the moment the page opens!
    loadCloudData();

    // ─── Event delegation for card buttons ────────────────────────────
    document.getElementById('resumeList').addEventListener('click', e => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const { action, id, type } = btn.dataset;
      if (action === 'delete')       deleteItem(id, type);
      else if (action === 'edit')    editItem(id, type);
      else if (action === 'preview') previewDoc(id, type);
      else if (action === 'analyze') useForAnalysis(id, type);
    });
    document.getElementById('coverList').addEventListener('click', e => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const { action, id, type } = btn.dataset;
      if (action === 'delete')       deleteItem(id, type);
      else if (action === 'edit')    editItem(id, type);
      else if (action === 'preview') previewDoc(id, type);
    });

    // ─── Add Resume ────────────────────────────────────────────────────
    document.getElementById('btnSaveResume').addEventListener('click', async () => {
      const title = document.getElementById('resumeTitle').value.trim();
      const notes = document.getElementById('resumeNotes').value.trim();
      const file  = document.getElementById('resumeFilePdf').files?.[0];
      
      if (!title) { document.getElementById('resumeTitle').focus(); showToast('Please enter a title.'); return; }
      if (!file)  { showToast('Please select a PDF file.'); return; }
      
      const btn = document.getElementById('btnSaveResume');
      btn.disabled = true; btn.textContent = 'Saving…';
      try {
  const upload = await uploadToSupabase(file, 'resumes');
  const items = dedupByPath([{ id: upload.path, title, notes, dataUrl: upload.signedUrl || '', path: upload.path, score: null, createdAt: new Date().toISOString() }, ...loadItems(RESUME_KEY)]);
  saveItems(RESUME_KEY, items);
        document.getElementById('resumeForm').style.display = 'none';
        renderResumes();
        showToast('Resume saved!');
      } catch(e) { console.error(e); showToast('Upload failed.'); }
      finally    { btn.disabled = false; btn.textContent = 'Save Resume'; }
    });

    // ─── Add Cover Letter ──────────────────────────────────────────────
    document.getElementById('btnSaveCover').addEventListener('click', async () => {
      const title = document.getElementById('coverTitle').value.trim();
      const notes = document.getElementById('coverNotes').value.trim();
      const file  = document.getElementById('coverFilePdf').files?.[0];
      
      if (!title) { document.getElementById('coverTitle').focus(); showToast('Please enter a title.'); return; }
      if (!file)  { showToast('Please select a PDF file.'); return; }
      
      const btn = document.getElementById('btnSaveCover');
      btn.disabled = true; btn.textContent = 'Saving…';
      try {
  const upload = await uploadToSupabase(file, 'cover-letters');
  const items = dedupByPath([{ id: upload.path, title, notes, dataUrl: upload.signedUrl || '', path: upload.path, createdAt: new Date().toISOString() }, ...loadItems(COVER_KEY)]);
  saveItems(COVER_KEY, items);
        document.getElementById('coverForm').style.display = 'none';
        renderCovers();
        showToast('Cover letter saved!');
      } catch(e) { console.error(e); showToast('Upload failed.'); }
      finally    { btn.disabled = false; btn.textContent = 'Save Cover Letter'; }
    });

    // ─── Delete (Cloud Version) ────────────────────────────────────────
    window.deleteItem = async (id, type) => {
      if (!confirm(`Are you sure you want to permanently delete this ${type === 'resume' ? 'resume' : 'cover letter'} from the cloud?`)) return;
      
      try {
        // 1. Send the DELETE request to our new backend route
        const response = await fetch(`/api/storage/files/${id}`, {
            method: 'DELETE'
        });

        if (!response.ok) {
            const errData = await response.json();
            throw new Error(errData.error || 'Failed to delete file from server.');
        }

        showToast('🗑️ Deleted from Supabase Vault.');
        
        // 2. Automatically refresh the list to show the file is gone!
        await loadCloudData();

      } catch (error) {
        console.error("Delete Error:", error);
        showToast('❌ Error: ' + error.message);
      }
    };

    // ─── Edit (title + notes + optional replace PDF) ───────────────────
    window.editItem = (id, type) => {
      const key   = type === 'resume' ? RESUME_KEY : COVER_KEY;
      const items = loadItems(key);
      const item  = items.find(i => i.id === id);
      if (!item) return;

      const overlay = document.createElement('div');
      overlay.className = 'profile-modal-overlay';
      overlay.innerHTML = `
        <div class="profile-modal" role="dialog" aria-modal="true">
          <div class="profile-modal-header">
            <span style="font-weight:800;font-size:16px;">Edit ${type === 'resume' ? 'Resume' : 'Cover Letter'}</span>
            <button class="profile-modal-close" aria-label="Close">✕</button>
          </div>
          <label class="profile-label" style="margin-top:14px;">Title
            <input class="profile-input" id="editTitle" value="${escHtml(item.title||'')}" />
          </label>
          <label class="profile-label" style="margin-top:10px;">Notes
            <textarea class="profile-textarea" id="editNotes" rows="3">${escHtml(item.notes||'')}</textarea>
          </label>
          <label class="profile-label" style="margin-top:10px;">Replace PDF (optional — leave blank to keep current)
            <div class="profile-file-drop" id="editDropZone">
              <span class="profile-file-drop-icon">${item.dataUrl ? '✅' : '📄'}</span>
              <span id="editDropLabel">${item.dataUrl ? 'Current PDF saved — drop here to replace' : 'No PDF — drop one here'}</span>
              <input type="file" id="editFilePdf" accept=".pdf,.doc,.docx" class="profile-file-input-hidden" />
            </div>
          </label>
          <div class="profile-modal-footer">
            <button class="btn btn-primary" type="button" id="editSaveBtn">Save Changes</button>
            <button class="btn btn-outline" type="button" id="editCancelBtn">Cancel</button>
          </div>
        </div>`;
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';
      setupDropZone('editDropZone', 'editFilePdf', 'editDropLabel');

      const close = () => { overlay.remove(); document.body.style.overflow = ''; };
      overlay.querySelector('.profile-modal-close').addEventListener('click', close);
      overlay.querySelector('#editCancelBtn').addEventListener('click', close);
      overlay.addEventListener('click', e => { if (e.target === overlay) close(); });

      overlay.querySelector('#editSaveBtn').addEventListener('click', async () => {
        const newTitle = overlay.querySelector('#editTitle').value.trim();
        const newNotes = overlay.querySelector('#editNotes').value.trim();
        const newFile  = overlay.querySelector('#editFilePdf').files?.[0];
        if (!newTitle) { showToast('Title is required.'); return; }
        if (newFile) {
          const btn = overlay.querySelector('#editSaveBtn');
          btn.disabled = true; btn.textContent = 'Saving…';
          try {
            const upload = await uploadToSupabase(newFile, type === 'resume' ? 'resumes' : 'cover-letters');
            item.dataUrl = upload.signedUrl || '';
            item.path    = upload.path;
          }
          catch(e) { console.error(e); showToast('Upload failed.'); btn.disabled=false; btn.textContent='Save Changes'; return; }
        }
        item.title = newTitle;
        item.notes = newNotes;
        saveItems(key, items);
        close();
        type === 'resume' ? renderResumes() : renderCovers();
        showToast('Updated!');
      });
    };

    // ─── Preview PDF in modal ──────────────────────────────────────────
    window.previewDoc = (id, type) => {
      const key  = type === 'resume' ? RESUME_KEY : COVER_KEY;
      const item = loadItems(key).find(i => i.id === id);
      if (!item?.dataUrl) return;
      const overlay = document.createElement('div');
      overlay.className = 'profile-modal-overlay';
      overlay.innerHTML = `
        <div class="profile-modal profile-modal-wide" role="dialog" aria-modal="true">
          <div class="profile-modal-header">
            <span style="font-weight:800;font-size:16px;">${escHtml(item.title||'Document')}</span>
            <button class="profile-modal-close" aria-label="Close">✕</button>
          </div>
          <iframe src="${item.dataUrl}" class="profile-pdf-frame" title="PDF Preview"></iframe>
          <div class="profile-modal-footer">
            <a class="btn btn-primary" href="${item.dataUrl}" download="${escHtml((item.title||'file').replace(/[^a-z0-9]/gi,'_'))}.pdf">⬇ Download PDF</a>
            ${type === 'resume' ? `<button class="btn btn-outline" id="previewAnalyzeBtn">🔬 Use for Analysis</button>` : ''}
          </div>
        </div>`;
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';
      const close = () => { overlay.remove(); document.body.style.overflow = ''; };
      overlay.querySelector('.profile-modal-close').addEventListener('click', close);
      overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
      overlay.querySelector('#previewAnalyzeBtn')?.addEventListener('click', () => {
        close(); useForAnalysis(id, 'resume');
      });
    };

    // ─── Use for Analysis: store in sessionStorage, navigate to dashboard
    window.useForAnalysis = (id, type) => {
      sessionStorage.setItem('jc_analyze_id', id);
      sessionStorage.setItem('jc_analyze_type', type);
      window.location.href = '/dashboard';
    };

    // ─── Initial render + sync from Supabase ──────────────────────────
    (async () => {
      await syncFromSupabase('resumes', RESUME_KEY);
      await syncFromSupabase('cover-letters', COVER_KEY);
      renderResumes();
      renderCovers();
    })();
  })();
  </script>
</body>
</html>
