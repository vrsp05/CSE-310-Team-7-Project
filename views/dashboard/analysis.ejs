<!--
  views/dashboard/analysis.ejs - AI Analysis Results page (requires auth)
  Reads the aiResult object injected by the server (from session) and renders:
    - A circular match score ring (color-coded red/orange/green)
    - A summary paragraph and list of improvement suggestions
    - Two keyword columns: matching keywords and missing gaps
    - An editable textarea with the AI-improved resume or cover letter
    - Buttons to download as DOCX, print, or save to profile (localStorage)
  AI data is passed via a <script type="application/json"> tag to avoid XSS.
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Analysis Dashboard</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <meta name="jc-user" content="<%= user ? user.username : 'guest' %>" />
</head>
<body>
  <%- include('../partials/header') %>

  <main class="jobcoach-page">

    <!-- Top / Back -->
    <div class="jobcoach-topbar">
      <a class="btn btn-outline jobcoach-back" href="/dashboard">
        <span aria-hidden="true">←</span>
        <span>BACK</span>
      </a>
    </div>

    <!-- Page Title -->
    <header class="jobcoach-hero jobcoach-hero-compact">
      <h1 class="jobcoach-title">Analysis Dashboard</h1>
      <p class="jobcoach-subtitle">Resume vs Job Description Match</p>
    </header>

    <% if (typeof aiResult !== 'undefined' && aiResult) { %>
      <section class="panel jobcoach-panel-wide">
        <div class="panel-header">
          <h2 class="panel-title">AI Analysis Result</h2>
        </div>
        <div class="panel-body" style="padding:16px;">
          <!-- Summary rendered as HTML (markdown converted client-side) -->
          <div id="aiSummaryBox" style="margin-bottom:16px; font-size:15px; color:#333;"></div>

          <!-- Suggestions list rendered as HTML -->
          <div id="aiSuggestionsBox"></div>

          <!-- Editable improved resume / cover letter -->
          <div style="margin-top:20px;">
            <div class="suggested-subtitle" style="font-weight:700; margin-bottom:6px;" id="suggestedLabel">SUGGESTED RESUME (EDITABLE)</div>
            <textarea id="suggestedText" style="width:100%; height:320px; font-family:monospace; font-size:13px; padding:10px; border:1px solid #ddd; border-radius:6px;"></textarea>
            <div style="margin-top:8px; display:flex; gap:8px; flex-wrap:wrap;">
              <button class="btn btn-primary" type="button" id="btnDownloadWithChanges">⬇ DOWNLOAD AS DOCX</button>
              <button class="btn btn-outline" type="button" id="btnPrintSuggested">🖨 PRINT</button>
              <button class="btn btn-outline" type="button" id="btnSaveToProfile">💾 SAVE TO PROFILE</button>
            </div>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Main framed container -->
    <section class="jobcoach-frame jobcoach-frame-dashboard">

      <!-- SCORE -->
      <section class="jobcoach-score">
        <div class="score-card">
          <div class="score-ring" id="scoreRing" role="img" aria-label="Match score">
            <!-- The ring is pure CSS. Change --score to adjust. -->
            <div class="score-ring-inner">
              <div class="score-number" id="scoreNumber">--%</div>
              <div class="score-label">MATCH SCORE</div>
            </div>
          </div>
        </div>
      </section>

      <!-- KEYWORDS GRID -->
      <section class="jobcoach-grid jobcoach-grid-2">
        <!-- Matching Keywords -->
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">MATCHING KEYWORDS</h2>
          </div>

          <div class="panel-body">
            <ul class="keyword-list" id="matchingKeywordsList">
            </ul>
          </div>
        </div>

        <!-- Missing Gaps -->
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">MISSING GAPS</h2>
          </div>

          <div class="panel-body">
            <ul class="keyword-list" id="missingGapsList">
            </ul>
          </div>
        </div>
      </section>

    </section>
  </main>

  <%- include('../partials/footer') %>

  <!-- Hidden container for server-provided AI JSON (safe from script injection) -->
  <script type="application/json" id="aiJson">
    <%- JSON.stringify(aiResult || null).replace(/</g, '\\u003c') %>
  </script>

  <script>
    // ─── Minimal markdown → HTML renderer (bold, italic, headers, bullets) ───
    function renderMarkdown(text) {
      if (!text) return '';
      let html = text
        // Escape HTML first
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        // Headers
        .replace(/^### (.+)$/gm, '<h4 style="margin:.6em 0 .2em">$1</h4>')
        .replace(/^## (.+)$/gm,  '<h3 style="margin:.6em 0 .2em">$1</h3>')
        .replace(/^# (.+)$/gm,   '<h2 style="margin:.6em 0 .2em">$1</h2>')
        // Bold + italic
        .replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>')
        .replace(/\*\*(.+?)\*\*/g,     '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g,         '<em>$1</em>')
        // Bullet points (- or *)
        .replace(/^\s*[-*]\s+(.+)$/gm, '<li>$1</li>')
        // Line breaks
        .replace(/\n{2,}/g, '</p><p style="margin:.5em 0">')
        .replace(/\n/g, '<br>');
      // Wrap loose <li> in <ul>
      html = html.replace(/(<li>.*<\/li>)/gs, '<ul style="padding-left:1.4em;margin:.4em 0">$1</ul>');
      return '<p style="margin:.5em 0">' + html + '</p>';
    }

    // ─── Fill a <ul> element with keyword badge items ───
    function fillList(el, items) {
      if (!el) return;
      el.innerHTML = '';
      if (!items || items.length === 0) {
        el.innerHTML = '<li style="color:#aaa;font-style:italic">None found</li>';
        return;
      }
      items.forEach(item => {
        const li = document.createElement('li');
        li.style.cssText = 'padding:4px 10px; margin:4px 0; background:#f0f4ff; border-radius:20px; display:inline-block; font-size:13px; font-weight:600;';
        li.textContent = item;
        el.appendChild(li);
      });
    }

    // ─── Parse server-provided AI JSON ───
    let aiData = null;
    try {
      const el = document.getElementById('aiJson');
      if (el && el.textContent.trim()) aiData = JSON.parse(el.textContent);
    } catch(e) { console.error('aiJson parse error', e); }

    if (aiData) {
      const result   = (aiData.result || '').toString();
      const isCover  = aiData.mode === 'cover';

      // ── Update label based on mode ───────────────────────────────────
      const suggestedLabel = document.getElementById('suggestedLabel');
      if (suggestedLabel) suggestedLabel.textContent = isCover ? 'SUGGESTED COVER LETTER (EDITABLE)' : 'SUGGESTED RESUME (EDITABLE)';

      // ── 1. Summary ──────────────────────────────────────────────────────
      const summaryEl = document.getElementById('aiSummaryBox');
      if (summaryEl) {
        const summaryText = aiData.summary || '';
        summaryEl.innerHTML = summaryText ? renderMarkdown(summaryText) : renderMarkdown(result);
      }

      // ── 2. Suggestions ──────────────────────────────────────────────────
      const suggestionsEl = document.getElementById('aiSuggestionsBox');
      if (suggestionsEl && Array.isArray(aiData.suggestions) && aiData.suggestions.length) {
        let html = '<strong style="font-size:14px;">💡 Suggestions to improve your resume:</strong><ul style="padding-left:1.4em;margin:.6em 0">';
        aiData.suggestions.forEach(s => { html += `<li style="margin:.35em 0">${s.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</li>`; });
        html += '</ul>';
        suggestionsEl.innerHTML = html;
      }

      // ── 3. Suggested (edited) resume ────────────────────────────────────
      const suggestedTextEl = document.getElementById('suggestedText');
      if (suggestedTextEl) {
        const cleaned = (aiData.editedText || '')
          // Drop any leading "suggested resume" or "suggested cover letter" label that may have been injected
          .replace(/^\s*suggested\s+(resume|cover\s*letter)[:\-]?\s*/i, '')
          .trim();
        suggestedTextEl.value = cleaned;
      }

      // ── 4. Matching Keywords ─────────────────────────────────────────────
      fillList(document.getElementById('matchingKeywordsList'), aiData.matchingKeywords || []);

      // ── 5. Missing Gaps ──────────────────────────────────────────────────
      fillList(document.getElementById('missingGapsList'), aiData.missingGaps || []);

      // ── 6. Score ring ────────────────────────────────────────────────────
      let score = parseInt(aiData.score, 10);
      if (isNaN(score)) {
        // fallback: try to parse from raw result text
        const m = result.match(/(?:score|match score)[*:\s]*([0-9]{1,3})\s*(?:%|\/100)?/i);
        score = m ? parseInt(m[1], 10) : 45;
      }
      score = Math.max(0, Math.min(100, score));

      let ringColor = '#dc2626'; // red default
      if (score >= 80) ringColor = '#16a34a';      // green
      else if (score >= 60) ringColor = '#d97706'; // orange

      const scoreNumberEl = document.getElementById('scoreNumber');
      const scoreRingEl   = document.getElementById('scoreRing');
      if (scoreNumberEl) { scoreNumberEl.textContent = score + '%'; scoreNumberEl.style.color = ringColor; }
      if (scoreRingEl)   { scoreRingEl.style.background = `conic-gradient(${ringColor} ${score}%, #cfcfd6 0)`; }

      // ── 7. Download as DOCX ──────────────────────────────────────────────
      document.getElementById('btnDownloadWithChanges')?.addEventListener('click', async () => {
        const txt = suggestedTextEl?.value || '';
        try {
          const resp = await fetch('/download/corrected-docx', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ editedText: txt, filename: 'improved_resume' })
          });
          if (!resp.ok) { const j = await resp.json().catch(()=>null); alert('Download failed: ' + (j?.error || resp.statusText)); return; }
          const blob = new Blob([await resp.arrayBuffer()], { type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a'); a.href = url; a.download = 'improved_resume.docx'; document.body.appendChild(a); a.click(); a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 3000);
        } catch(e) { console.error(e); alert('Download error'); }
      });

      // ── 8. Print ─────────────────────────────────────────────────────────
      document.getElementById('btnPrintSuggested')?.addEventListener('click', () => {
        const content = suggestedTextEl?.value || '';

        // Extract first non-empty line as the name/header, rest as body
        const lines = content.split(/\r?\n/);
        let nameLine = '';
        const remaining = [...lines];
        for (let i = 0; i < remaining.length; i++) {
          if (remaining[i].trim()) { nameLine = remaining[i].trim(); remaining[i] = ''; break; }
        }
        const bodyText = remaining.join('\n').trim();

        const bodyHtml = renderMarkdown(bodyText);
        const safeName = nameLine.replace(/&/g,'&amp;').replace(/</g,'&lt;');

        // Dynamic sizing to better fit one page: shrink font as content grows
        const textLength = bodyText.length;
        let baseFont = 12; // default
        if (textLength > 4500) baseFont = 9;
        else if (textLength > 3500) baseFont = 10;
        else if (textLength > 2500) baseFont = 11;

        const headingSize = Math.max(baseFont + 0.5, baseFont + 1);
        const nameSize = Math.max(baseFont + 4, 14);

        const html = `<!DOCTYPE html>
          <html>
            <head>
              <title>${safeName || (isCover ? 'Cover Letter' : 'Resume')}</title>
              <style>
                :root { color-scheme: light; }
                @page { margin: 12mm; }
                body {
                  font-family: "Inter", "Segoe UI", system-ui, sans-serif;
                  font-size: ${baseFont}px;
                  padding: 6px 10px;
                  line-height: 1.4;
                  color: #0f172a;
                  background: #fff;
                }
                h1, h2, h3, h4 {
                  margin: 0 0 0.35em;
                  line-height: 1.25;
                  font-weight: 700;
                  text-transform: uppercase;
                  letter-spacing: 0.25px;
                  font-size: ${headingSize}px;
                }
                p { margin: 0 0 0.55em; }
                ul { margin: 0 0 0.55em 1.25em; padding: 0; }
                li { margin: 0.15em 0; }
                strong { font-weight: 700; }
                em { font-style: italic; }
                hr { border: none; border-top: 1px solid #e5e7eb; margin: 10px 0; }
                .name {
                  text-align: center;
                  font-weight: 800;
                  font-size: ${nameSize}px;
                  letter-spacing: 0.35px;
                  margin: 0 0 10px;
                  text-transform: uppercase;
                }
                .section-title {
                  font-weight: 800;
                  margin: 10px 0 4px;
                  text-transform: uppercase;
                  letter-spacing: 0.35px;
                  border-bottom: 1px solid #e5e7eb;
                  padding-bottom: 3px;
                  font-size: 12px;
                }
                .content { text-align: left; }
                .center { text-align: center; }
              </style>
            </head>
            <body>
              ${safeName ? `<div class="name">${safeName}</div>` : ''}
              <div class="content">${bodyHtml}</div>
            </body>
          </html>`;

        const w = window.open('about:blank','_blank');
        w.document.write(html);
        w.document.close();
        setTimeout(() => w.print(), 250);
      });

      // ── 9. Save to Profile ───────────────────────────────────────────────
      document.getElementById('btnSaveToProfile')?.addEventListener('click', () => {
        const content  = suggestedTextEl?.value || '';
        const typeLabel = isCover ? 'Cover Letter' : 'Resume';
        const title = prompt(`Name for this ${typeLabel} in your profile:`, `Analyzed ${typeLabel} — ` + new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }));
        if (title === null) return;

        let username = 'guest';
        try {
          const metaUser = document.querySelector('meta[name="jc-user"]');
          if (metaUser) username = metaUser.getAttribute('content') || 'guest';
        } catch(e) {}

        const STORAGE_KEY = isCover ? `jc_covers_${username}` : `jc_resumes_${username}`;
        let items = [];
        try { items = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch(e) {}

        const newItem = {
          id: Date.now().toString(36) + Math.random().toString(36).slice(2,6),
          title: title.trim() || `Untitled ${typeLabel}`,
          notes: '',
          content,
          score,
          createdAt: new Date().toISOString()
        };
        items.unshift(newItem);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));

        const toast = document.createElement('div');
        toast.textContent = `✅ Saved to Profile!`;
        Object.assign(toast.style, {
          position:'fixed', bottom:'28px', left:'50%', transform:'translateX(-50%)',
          background:'#111', color:'#fff', padding:'10px 24px', borderRadius:'24px',
          fontWeight:'700', fontSize:'14px', zIndex:'9999', transition:'opacity .3s'
        });
        document.body.appendChild(toast);
        setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 400); }, 2500);
      });
    }
  </script>
</body>
</html>
