<!--
  views/partials/header.ejs
  Shared navigation header included on all authenticated pages.
  Shows the logo, nav links (Home, About), and a user dropdown
  menu with links to Profile and Sign Out.
-->
<link rel="stylesheet" href="/css/header.css">
<header class="site-header">
    <div class="header-inner">
        <nav class="site-nav">
            <ul>
                <a href="/dashboard">
                    <img src="/images/logo.png" alt="AI JobCoach Logo" class="logo-image">
                </a>
                <li><a href="/dashboard">Home</a></li>
                <li><a href="/about">About</a></li>
            </ul>
        </nav>

        <div class="header-actions">
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="header-user-menu">
                    <button class="header-username" id="userMenuBtn">
                        👤 Hello, <%= user.username %>! ▾
                    </button>
                    <div class="header-dropdown" id="userDropdown">
                        <a href="/dashboard/profile" class="header-dropdown-item">My Profile</a>
                        <a href="/logout" class="header-dropdown-item header-dropdown-signout">Sign Out</a>
                    </div>
                </div>
            <% } else { %>
                <a href="/" class="header-signout">Sign In</a>
            <% } %>
        </div>
    </div>
</header>

<script>
    const userMenuBtn = document.getElementById('userMenuBtn');
    const userDropdown = document.getElementById('userDropdown');
    if (userMenuBtn) {
        userMenuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            userDropdown.classList.toggle('header-dropdown-open');
        });
        document.addEventListener('click', () => {
            userDropdown.classList.remove('header-dropdown-open');
        });
    }
</script>
