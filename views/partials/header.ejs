<link rel="stylesheet" href="/css/header.css">
<header class="site-header">
    <div class="header-inner">
        <nav class="site-nav">
            <ul>
                <a href="/dashboard">
                    <img src="/images/logo.png" alt="AI JobCoach Logo" class="logo-image">
                </a>
                <li><a href="/dashboard">Home</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/dashboard/profile">My Profile</a></li>
            </ul>
        </nav>

        <div class="header-actions">
            <% if (typeof user !== 'undefined' && user) { %>
                <span class="header-username">Hello <%= user.username %>!</span>
                <a href="/logout" class="header-signout">Sign Out</a>
            <% } else { %>
                <a href="/" class="header-signout">Sign In</a>
            <% } %>
        </div>
    </div>
</header>
