<!--
  views/index.ejs - Login page (public, no auth required)
  Displays the login form and Register / Google OAuth buttons.
  On successful login the client-side JS stores the Supabase JWT
  as a cookie (supabaseToken) and redirects to /dashboard.
  If the user is already logged in, the server redirects them
  directly to /dashboard before this page is rendered.
-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI JobCoach</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <div id="title">
        <h1>Welcome to AI JobCoach</h1>
        <p>Your personal assistant for job hunting powered by AI.</p>
    </div>

    <div class="login-section">

    <% if (error) { %>
        <p class="error-msg"><%= error %></p>
    <% } %>

    <form id="login-form">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required>
        <br>

        <label for="password">Password:</label>
        <input type="password" id="password" name="password" required>
        <br>

        <button type="submit">Login</button>
    </form>

    <form id="register-form" action="/register" method="GET">
        <button type="submit">Register</button>
    </form>

    <form id="google-oauth-form" action="/auth/google" method="GET">
        <button type="submit">Login with Google</button>
    </form>
    </div>

    <%- include('partials/footer') %>

    <script>
        document.getElementById('login-form').addEventListener('submit', async (e) => {
            e.preventDefault(); 
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                const data = await response.json();

                if (response.ok) {
                    // Set the token as a cookie so requireAuth can read it
                    document.cookie = `supabaseToken=${data.session.access_token}; path=/; max-age=3600; SameSite=Strict`;
                    window.location.href = '/dashboard';
                } else {
                    alert("Login failed: " + (data.error || "Check your credentials."));
                }
            } catch (err) {
                console.error("Login error:", err);
                alert("An error occurred trying to reach the server.");
            }
        });
    </script>
</body>
</html>